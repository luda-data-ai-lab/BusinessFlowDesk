# Server-side only (Vercel function / Vite dev proxy). Never expose to the browser.
CLAUDE_API_KEY=sk-ant-...
# Optional: override model
CLAUDE_MODEL=claude-sonnet-4-6
# Self-hosted (vite preview behind nginx): comma-separated hostnames allowed to reach the server
ALLOWED_HOSTS=bf.example.com
# Optional: port for dev/preview server (default 5173/4173)
PORT=5175
